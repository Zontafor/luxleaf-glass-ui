{
  "name": "@zontafor/luxleaf-glass-ui",
  "version": "0.2.0",
  "type": "module",
  "license": "LicenseRef-Proprietary",
  "author": "Michelle L. Wu",
  "description": "Accessible glass components and a real optical pipeline with nested GPU refraction.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./webgl": {
      "types": "./dist/webgl.d.ts",
      "import": "./dist/webgl.js"
    },
    "./webgl.css": "./engine/glass.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "third_party",
    "docs",
    "engine",
    "foundations",
    "src",
    "demo",
    "tests",
    "scripts",
    "integrations",
    "tsconfig.json",
    "tsconfig.build.json",
    "vite.config.ts",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify": "npm run verify:foundation && npm run typecheck && npm test && npm run build",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:foundation": "node scripts/verify-foundation.mjs"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zontafor/luxleaf-glass-ui.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
